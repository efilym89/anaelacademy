{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anaelacademy",
  "main": "./worker.js",
  "compatibility_date": "2026-03-18",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-pages",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
